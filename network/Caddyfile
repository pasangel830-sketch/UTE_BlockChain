# Día 12: FQDN público → API en la red Docker ute-prod.
# Día 13: /grafana → VM monitoring-ute (GRAFANA_UPSTREAM). Imagen caddy:2.11.4.
# Firewall: 80/443 a Internet; no abrir 7051 ni métricas.
# Sin email ACME: "off" lo rechaza Let's Encrypt.

{$API_FQDN:localhost} {
	encode gzip
	handle /grafana* {
		reverse_proxy {$GRAFANA_UPSTREAM} {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_down -X-Frame-Options
		}
	}
	handle {
		reverse_proxy ute-api:4000
	}
}
